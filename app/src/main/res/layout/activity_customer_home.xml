<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_white"
    android:padding="24dp">

    <!-- App Logo -->

    <TextView
        android:id="@+id/tvHomeLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TECHFIX"
        android:textColor="@color/techfix_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Welcome -->

    <TextView
        android:id="@+id/tvHomeWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:text="Welcome to TechFix!"
        android:textColor="@color/techfix_text"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHomeLogo" />

    <!-- Description -->

    <TextView
        android:id="@+id/tvHomeDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Computer and mobile phone repairs made easier."
        android:textColor="@color/techfix_secondary_text"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHomeWelcome" />

    <!-- Repair Services -->

    <Button
        android:id="@+id/btnServices"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:backgroundTint="@color/techfix_primary"
        android:text="REPAIR SERVICES"
        android:textColor="@color/techfix_white"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHomeDescription" />

    <!-- Appointments -->

    <Button
        android:id="@+id/btnAppointments"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:backgroundTint="@color/techfix_secondary"
        android:text="MY APPOINTMENTS"
        android:textColor="@color/techfix_white"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnServices" />

    <!-- Repair History -->

    <Button
        android:id="@+id/btnHistory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:backgroundTint="@color/techfix_light_yellow"
        android:text="REPAIR HISTORY"
        android:textColor="@color/techfix_text"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnAppointments" />

    <!-- Branches -->

    <Button
        android:id="@+id/btnBranches"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:backgroundTint="@color/techfix_light_pink"
        android:text="BRANCHES &amp; LOCATIONS"
        android:textColor="@color/techfix_text"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnHistory" />

</androidx.constraintlayout.widget.ConstraintLayout>