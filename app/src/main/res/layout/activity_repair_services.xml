<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/techfix_white"
    android:padding="24dp">

    <!-- Logo -->

    <TextView
        android:id="@+id/tvServicesLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TECHFIX"
        android:textColor="@color/techfix_primary"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->

    <TextView
        android:id="@+id/tvServicesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:text="Repair Services"
        android:textColor="@color/techfix_text"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvServicesLogo" />

    <!-- Description -->

    <TextView
        android:id="@+id/tvServicesDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Choose the type of device you need to repair."
        android:textColor="@color/techfix_secondary_text"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvServicesTitle" />

    <!-- Computer Repair -->

    <Button
        android:id="@+id/btnComputerRepair"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="35dp"
        android:backgroundTint="@color/techfix_primary"
        android:text="COMPUTER REPAIR"
        android:textColor="@color/techfix_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvServicesDescription" />

    <!-- Mobile Repair -->

    <Button
        android:id="@+id/btnMobileRepair"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:backgroundTint="@color/techfix_secondary"
        android:text="MOBILE PHONE REPAIR"
        android:textColor="@color/techfix_white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnComputerRepair" />

</androidx.constraintlayout.widget.ConstraintLayout>