<?xml version="1.0" encoding="utf-8"?>

<!--
    Appointment Card
    This layout represents one repair appointment
    inside the My Appointments RecyclerView.
-->

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="12dp"

    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <!-- Content inside the appointment card -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Device Type -->

        <TextView
            android:id="@+id/tvAppointmentDeviceType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mobile Phone"
            android:textColor="@color/techfix_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Device Model -->

        <TextView
            android:id="@+id/tvAppointmentModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Device: Samsung Galaxy S24"
            android:textColor="@color/techfix_text"
            android:textSize="15sp" />

        <!-- Problem -->

        <TextView
            android:id="@+id/tvAppointmentProblem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Problem: Screen is damaged"
            android:textColor="@color/techfix_secondary_text"
            android:textSize="15sp" />

        <!-- Preferred Date -->

        <TextView
            android:id="@+id/tvAppointmentDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Preferred Date: 25/08/2026"
            android:textColor="@color/techfix_text"
            android:textSize="15sp" />

        <!-- Appointment Status -->

        <TextView
            android:id="@+id/tvAppointmentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/techfix_light_pink"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="Pending"
            android:textColor="@color/techfix_text"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>