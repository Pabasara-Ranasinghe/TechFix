<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="12dp"

    app:cardBackgroundColor="@color/techfix_white"
    app:cardCornerRadius="15dp"
    app:cardElevation="3dp">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="16dp">


        <TextView
            android:id="@+id/tvBookingDevice"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Laptop"
            android:textColor="@color/techfix_primary"
            android:textSize="18sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/tvBookingModel"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="Model: Dell Inspiron"
            android:textColor="@color/techfix_text"
            android:textSize="14sp" />


        <TextView
            android:id="@+id/tvBookingProblem"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Problem: Screen not working"
            android:textColor="@color/techfix_secondary_text"
            android:textSize="14sp" />


        <TextView
            android:id="@+id/tvBookingDate"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Preferred Date: 23/08/2026"
            android:textColor="@color/techfix_secondary_text"
            android:textSize="14sp" />


        <TextView
            android:id="@+id/tvBookingStatus"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:text="Status: Pending"
            android:textColor="@color/techfix_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>