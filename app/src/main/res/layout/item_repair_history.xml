<?xml version="1.0" encoding="utf-8"?>

<!--
    Repair History Card

    This layout represents one completed repair
    inside the Repair History RecyclerView.
-->

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="12dp"

    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <!-- Card content -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="16dp">

        <!-- Device Type -->

        <TextView
            android:id="@+id/tvHistoryDeviceType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Mobile Phone"
            android:textColor="@color/techfix_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Device Model -->

        <TextView
            android:id="@+id/tvHistoryModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="Device: Samsung Galaxy"
            android:textColor="@color/techfix_text"
            android:textSize="15sp" />

        <!-- Problem -->

        <TextView
            android:id="@+id/tvHistoryProblem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="Problem: Screen damaged"
            android:textColor="@color/techfix_secondary_text"
            android:textSize="15sp" />

        <!-- Completion Date -->

        <TextView
            android:id="@+id/tvHistoryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="Repair Date: 25/08/2026"
            android:textColor="@color/techfix_text"
            android:textSize="15sp" />

        <!-- Status -->

        <TextView
            android:id="@+id/tvHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:background="@color/techfix_light_yellow"

            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"

            android:text="Completed"
            android:textColor="@color/techfix_text"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>