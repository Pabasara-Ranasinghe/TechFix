<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"

    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Spare Part Name -->

        <TextView
            android:id="@+id/tvSparePartName"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Laptop Screen"
            android:textColor="@color/techfix_primary"
            android:textSize="18sp"
            android:textStyle="bold" />


        <!-- Category -->

        <TextView
            android:id="@+id/tvSparePartCategory"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="6dp"

            android:text="Category: Laptop"
            android:textColor="@color/techfix_text"
            android:textSize="14sp" />


        <!-- Quantity -->

        <TextView
            android:id="@+id/tvSparePartQuantity"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Quantity: 5"
            android:textColor="@color/techfix_secondary_text"
            android:textSize="14sp" />


        <!-- Price -->

        <TextView
            android:id="@+id/tvSparePartPrice"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Price: Rs. 25000"
            android:textColor="@color/techfix_primary"
            android:textSize="14sp"
            android:textStyle="bold" />


        <!-- ACTION BUTTONS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEditSparePart"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="EDIT"
                android:textStyle="bold" />


            <Button
                android:id="@+id/btnDeleteSparePart"

                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_marginStart="10dp"

                android:layout_weight="1"

                android:text="DELETE"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>